#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// ============================================================
// German QWERTZ & macOS symbol mappings (NeoQWERTZ layout)
// ============================================================

// Base German letters & umlauts (sent via standard HID keycodes interpreted by German OS)
#define DE_Y    Z            // Physical Y position sends HID Z -> types 'y' on German OS
#define DE_Z    Y            // Physical Z position sends HID Y -> types 'z' on German OS
#define DE_ODIA SEMI         // 'ö' / 'Ö'
#define DE_ADIA SQT          // 'ä' / 'Ä'
#define DE_UDIA LBKT         // 'ü' / 'Ü'
#define DE_SS   MINUS        // 'ß' / '?'
#define DE_MINS FSLH         // '-' / '_'

// Symbols on German layout
#define DE_EXLM LS(N1)       // '!'
#define DE_DQUO LS(N2)       // '"'
#define DE_DLR  LS(N4)       // '$'
#define DE_PERC LS(N5)       // '%'
#define DE_AMPR LS(N6)       // '&'
#define DE_SLSH LS(N7)       // '/'
#define DE_LPRN LS(N8)       // '('
#define DE_RPRN LS(N9)       // ')'
#define DE_EQL  LS(N0)       // '='
#define DE_QUES LS(MINUS)    // '?'
#define DE_GRV  LS(EQUAL)    // '`'
#define DE_UNDS LS(FSLH)     // '_'
#define DE_COLN LS(DOT)      // ':'
#define DE_SCLN LS(COMMA)    // ';'
#define DE_QUOT LS(BSLH)     // '''
#define DE_ASTR LS(RBKT)     // '*'
#define DE_LABK NUBS         // '<'
#define DE_RABK LS(NUBS)     // '>'
#define DE_PLUS RBKT         // '+'
#define DE_HASH BSLH         // '#'
#define DE_CIRC GRAVE        // '^'

// macOS German symbols (resMagi default)
#define DE_AT   LA(L)        // '@' (Option + L on macOS)
#define DE_BSLS LS(LA(N7))   // '\' (Shift + Option + 7 on macOS)
#define DE_LBRC LA(N5)       // '[' (Option + 5 on macOS)
#define DE_RBRC LA(N6)       // ']' (Option + 6 on macOS)
#define DE_LCBR LA(N8)       // '{' (Option + 8 on macOS)
#define DE_RCBR LA(N9)       // '}' (Option + 9 on macOS)
#define DE_PIPE LA(N7)       // '|' (Option + 7 on macOS)
#define DE_TILD LA(N)        // '~' (Option + N on macOS)

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "QWERTZ";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Z  |  U   |  I  |  O  |  P  | BKSP |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  Ö  |  Ä   |
// | CTRL |  Y  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  -  | REP  |
//                    | GUI | L(2)| SPC |   | ENT | L(1) | ALT |
            bindings = <
   &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T      &kp DE_Z  &kp U     &kp I      &kp O    &kp P        &kp BSPC
   &kp LSHFT &kp A    &kp S    &kp D    &kp F    &kp G      &kp H     &kp J     &kp K      &kp L    &kp DE_ODIA  &kp DE_ADIA
   &kp LCTRL &kp DE_Y &kp X    &kp C    &kp V    &kp B      &kp N     &kp M     &kp COMMA  &kp DOT  &kp DE_MINS  &key_repeat
                      &kp LGUI &mo 2    &kp SPACE           &kp RET   &mo 1     &kp LALT
            >;
        };

        symbol_layer {
            display-name = "Symbols";
// -----------------------------------------------------------------------------------------
// |  TAB |  @  |  _  |  [  |  ]  |  ^  |   |  !  |  <   |  >  |  =  |  &  | BKSP |
// | SHFT |  \  |  /  |  {  |  }  |  *  |   |  ?  |  (   |  )  |  ß  |  :  |  Ü   |
// | CTRL |  #  |  $  |  |  |  ~  |  `  |   |  +  |  %   |  "  |  '  |  ;  | REP  |
//                    | GUI | L(3)| SPC |   | ENT |      | RGUI|
            bindings = <
   &kp TAB   &kp DE_AT   &kp DE_UNDS &kp DE_LBRC &kp DE_RBRC &kp DE_CIRC    &kp DE_EXLM &kp DE_LABK &kp DE_RABK &kp DE_EQL  &kp DE_AMPR &kp BSPC
   &kp LSHFT &kp DE_BSLS &kp DE_SLSH &kp DE_LCBR &kp DE_RCBR &kp DE_ASTR    &kp DE_QUES &kp DE_LPRN &kp DE_RPRN &kp DE_SS   &kp DE_COLN &kp DE_UDIA
   &kp LCTRL &kp DE_HASH &kp DE_DLR  &kp DE_PIPE &kp DE_TILD &kp DE_GRV     &kp DE_PLUS &kp DE_PERC &kp DE_DQUO &kp DE_QUOT &kp DE_SCLN &key_repeat
                         &kp LGUI    &mo 3       &kp SPACE                  &kp RET     &none       &kp RGUI
            >;
        };

        nav_num_layer {
            display-name = "Nav/Num";
// -----------------------------------------------------------------------------------------
// |  TAB | BKSP|  UP | DEL | PGUP| HOME|   |  0  |  1   |  2  |  3  |  4  | BKSP |
// | SHFT | LEFT| DOWN| RGHT| PGDN| END |   |  5  |  6   |  7  |  8  |  9  |      |
// | CTRL |     |     |     |     |     |   |     |      |  "  |  '  |  ;  | REP  |
//                    | GUI |     | ENT |   | SPC | L(3) | RGUI|
            bindings = <
   &kp TAB   &kp BSPC &kp UP   &kp DEL   &kp PG_UP &kp HOME    &kp N0    &kp N1    &kp N2      &kp N3      &kp N4      &kp BSPC
   &kp LSHFT &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &kp END     &kp N5    &kp N6    &kp N7      &kp N8      &kp N9      &none
   &kp LCTRL &none    &none    &none     &none     &none       &none     &none     &kp DE_DQUO &kp DE_QUOT &kp DE_SCLN &key_repeat
                      &kp LGUI &none     &kp RET               &kp SPACE &mo 3     &kp RGUI
            >;
        };

        system_layer {
            display-name = "System";
// -----------------------------------------------------------------------------------------
// |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8  |  F9 | F10 | F11 | F12  |
// |      | BT1 | BT2 | BT3 | BT4 |BTCLR|   | Alt1| Alt2 | Alt3| Alt4| Alt5|      |
// |      |STUDO|STUDO|RESET|BOOTL|BOOTL|   |     |      |     |     |     | REP  |
//                    | GUI |     | ENT |   | SPC |      | RGUI|
            bindings = <
   &kp F1 &kp F2         &kp F3         &kp F4        &kp F5         &kp F6          &kp F7        &kp F8        &kp F9        &kp F10       &kp F11 &kp F12
   &none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_CLR      &kp LA(N1)    &kp LA(N2)    &kp LA(N3)    &kp LA(N4)    &kp LA(N5) &none
   &none  &studio_unlock &studio_unlock &sys_reset    &bootloader    &bootloader     &none         &none         &none         &none         &none   &key_repeat
                         &kp LGUI       &none         &kp RET                        &kp SPACE     &none         &kp RGUI
            >;
        };
    };
};
